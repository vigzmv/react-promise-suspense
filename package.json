{
  "name": "react-promise-suspense",
  "version": "0.4.0",
  "description": "React hook for resolving promises with Suspense support",
  "keywords": [
    "react",
    "fetch",
    "suspense",
    "promise",
    "hooks"
  ],
  "homepage": "https://github.com/vigzmv/react-promise-suspense#readme",
  "bugs": {
    "url": "https://github.com/vigzmv/react-promise-suspense/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigzmv/react-promise-suspense.git"
  },
  "license": "MIT",
  "author": "Vignesh M <vigzmv@outlook.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vigzmv"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "lib/index.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --outDir build",
    "dev": "tsc --outDir build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "package:check": "npm pack --dry-run",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "npm run build && tsd",
    "coverage": "vitest run --coverage"
  },
  "tsd": {
    "directory": "lib"
  },
  "peerDependencies": {
    "react": ">=16.6.0"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsd": "^0.33.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
